<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CodeChef API - The Ultimate Developer Tool</title>
    <meta name="description" content="High-performance CodeChef API for developers. Build leaderboards, portfolios, and analytics tools with ease.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.8/clipboard.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .code-block {
            font-family: 'Fira Code', monospace;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-50 antialiased selection:bg-brand-500 selection:text-white">

    <!-- Navbar -->
    <nav class="fixed w-full z-50 glass border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">🚀</span>
                    <span class="font-bold text-xl tracking-tight">CodeChef API</span>
                </div>
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <a href="#features" class="hover:text-brand-400 px-3 py-2 rounded-md text-sm font-medium transition-colors">Features</a>
                        <a href="#endpoints" class="hover:text-brand-400 px-3 py-2 rounded-md text-sm font-medium transition-colors">Endpoints</a>
                        <a href="#widgets" class="hover:text-brand-400 px-3 py-2 rounded-md text-sm font-medium transition-colors">Widgets</a>
                        <a href="https://github.com/shivam-smraj/CodeChef-API" target="_blank" class="bg-brand-600 hover:bg-brand-500 text-white px-4 py-2 rounded-full text-sm font-medium transition-all">GitHub Star ⭐</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight mb-8 bg-clip-text text-transparent bg-gradient-to-r from-brand-400 to-purple-500">
                Supercharge Your <br/> CodeChef Portfolio
            </h1>
            <p class="mt-4 text-xl text-slate-400 max-w-2xl mx-auto mb-10">
                The most powerful, high-performance API to fetch CodeChef user data. <br/>
                Build leaderboards, analytics dashboards, and stunning portfolios in minutes.
            </p>
            <div class="flex justify-center gap-4">
                <a href="#endpoints" class="bg-white text-slate-900 px-8 py-3 rounded-full font-bold hover:bg-slate-200 transition-all">Get Started</a>
                <a href="#widgets" class="glass px-8 py-3 rounded-full font-bold hover:bg-white/10 transition-all">View Widgets</a>
            </div>
        </div>
        
        <!-- Background Glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full z-0 pointer-events-none">
            <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl"></div>
            <div class="absolute top-40 right-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
        </div>
    </div>

    <!-- Features Grid -->
    <div id="features" class="py-20 bg-slate-800/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold">Why use this API?</h2>
                <p class="text-slate-400 mt-2">Built for performance and scalability.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="glass p-8 rounded-2xl hover:-translate-y-1 transition-transform duration-300">
                    <div class="text-4xl mb-4">⚡</div>
                    <h3 class="text-xl font-bold mb-2">Blazing Fast</h3>
                    <p class="text-slate-400">Powered by Cheerio and Node-Cache. Responses are cached for 1 hour to ensure sub-millisecond latency.</p>
                </div>
                <div class="glass p-8 rounded-2xl hover:-translate-y-1 transition-transform duration-300">
                    <div class="text-4xl mb-4">📊</div>
                    <h3 class="text-xl font-bold mb-2">Leaderboard Ready</h3>
                    <p class="text-slate-400">Fetch data for up to 100 users in a single request. Perfect for college clubs and organizations.</p>
                </div>
                <div class="glass p-8 rounded-2xl hover:-translate-y-1 transition-transform duration-300">
                    <div class="text-4xl mb-4">🛠️</div>
                    <h3 class="text-xl font-bold mb-2">Developer Friendly</h3>
                    <p class="text-slate-400">Clean JSON responses, granular endpoints, and pre-built embeddable widgets for your site.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- API Endpoints Section -->
    <div id="endpoints" class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold mb-12 border-l-4 border-brand-500 pl-4">API Reference</h2>
            
            <!-- Endpoint 1 -->
            <div class="mb-12">
                <div class="flex items-center gap-4 mb-4">
                    <span class="bg-green-500/20 text-green-400 px-3 py-1 rounded text-sm font-mono font-bold">GET</span>
                    <code class="text-lg text-slate-200">/handle/{username}</code>
                </div>
                <p class="text-slate-400 mb-4">Get full profile data including ratings, ranks, and heatmap.</p>
                <div class="bg-slate-950 rounded-xl p-4 overflow-x-auto border border-slate-800 relative group">
                    <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text="https://sm-codechef.vercel.app/handle/gennady.korotkevich">Copy URL</button>
                    <code class="text-brand-400">https://sm-codechef.vercel.app/handle/gennady.korotkevich</code>
                </div>
            </div>

            <!-- Endpoint 2 -->
            <div class="mb-12">
                <div class="flex items-center gap-4 mb-4">
                    <span class="bg-green-500/20 text-green-400 px-3 py-1 rounded text-sm font-mono font-bold">GET</span>
                    <code class="text-lg text-slate-200">/api/users</code>
                    <span class="bg-brand-500/20 text-brand-300 px-2 py-0.5 rounded text-xs uppercase tracking-wider">New</span>
                </div>
                <p class="text-slate-400 mb-4">Fetch multiple users at once. Ideal for leaderboards.</p>
                <div class="bg-slate-950 rounded-xl p-4 overflow-x-auto border border-slate-800 relative group">
                    <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text="https://sm-codechef.vercel.app/api/users?handles=neal,gennady.korotkevich">Copy URL</button>
                    <code class="text-brand-400">https://sm-codechef.vercel.app/api/users?handles=neal,gennady.korotkevich</code>
                </div>
            </div>

             <!-- Endpoint 3 -->
             <div class="mb-12">
                <div class="flex items-center gap-4 mb-4">
                    <span class="bg-green-500/20 text-green-400 px-3 py-1 rounded text-sm font-mono font-bold">GET</span>
                    <code class="text-lg text-slate-200">/api/rating/{username}</code>
                </div>
                <p class="text-slate-400 mb-4">Get only rating history data (lighter response).</p>
                <div class="bg-slate-950 rounded-xl p-4 overflow-x-auto border border-slate-800 relative group">
                    <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text="https://sm-codechef.vercel.app/api/rating/neal">Copy URL</button>
                    <code class="text-brand-400">https://sm-codechef.vercel.app/api/rating/neal</code>
                </div>
            </div>

            <!-- Endpoint 4: Granular Data -->
            <div class="mb-12">
                <div class="flex items-center gap-4 mb-4">
                    <span class="bg-green-500/20 text-green-400 px-3 py-1 rounded text-sm font-mono font-bold">GET</span>
                    <code class="text-lg text-slate-200">/handle/{username}?fields={...}</code>
                    <span class="bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded text-xs uppercase tracking-wider">Advanced</span>
                </div>
                <p class="text-slate-400 mb-4">
                    Fetch only specific data fields to reduce payload size. <br/>
                    <span class="text-sm opacity-70">Available fields: contestCount, currentRating, highestRating, stars, globalRank, countryRank, profile, totalProblemsSolved, lastRatingChange</span>
                </p>
                <div class="bg-slate-950 rounded-xl p-4 overflow-x-auto border border-slate-800 relative group">
                    <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text="https://sm-codechef.vercel.app/handle/neal?fields=stars,currentRating,globalRank">Copy URL</button>
                    <code class="text-brand-400">https://sm-codechef.vercel.app/handle/neal?fields=stars,currentRating,globalRank</code>
                </div>
                <div class="mt-4 bg-slate-900/50 p-4 rounded-lg border border-slate-800/50">
                    <p class="text-xs text-slate-500 mb-2">Response Preview:</p>
                    <pre class="text-xs text-slate-300 font-mono">{
  "success": true,
  "status": 200,
  "stars": "7★",
  "currentRating": 2650,
  "globalRank": 12
}</pre>
                </div>
            </div>
        </div>
    </div>

    <!-- JSON Response Schemas -->
    <div class="py-20 bg-slate-800/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold mb-12 border-l-4 border-green-500 pl-4">Response Schemas</h2>
            
            <div class="space-y-16">
                
                <!-- Schema 1: Full Profile -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 border-b border-slate-800 pb-12">
                    <div class="lg:col-span-1">
                        <h3 class="text-xl font-bold text-white mb-2">Full Profile</h3>
                        <code class="text-sm text-brand-400 bg-brand-900/30 px-2 py-1 rounded">/handle/{username}</code>
                        <p class="text-slate-400 mt-4 text-sm leading-relaxed">
                            Returns comprehensive data about a user, including their current rating, ranks, submission heatmap, and rating history.
                        </p>
                    </div>
                    <div class="lg:col-span-2 bg-slate-950 rounded-xl p-6 border border-slate-800 overflow-hidden relative group">
                        <div class="absolute top-0 left-0 w-full h-8 bg-slate-900 border-b border-slate-800 flex items-center px-4 gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="text-xs sm:text-sm text-slate-300 font-mono mt-6 overflow-x-auto max-h-96 custom-scrollbar">
{
  "success": true,
  "status": 200,
  "profile": "https://cdn.codechef.com/sites/...",
  "name": "Gennady Korotkevich",
  "currentRating": 3979,
  "highestRating": 3979,
  "countryFlag": "https://cdn.codechef.com/...",
  "countryName": "Belarus",
  "globalRank": 1,
  "countryRank": 1,
  "stars": "7★",
  "totalProblemsSolved": 1680,
  "contestCount": 85,
  "lastRatingChange": 0,
  "heatMap": [
    { "date": "2023-10-01", "value": 5 },
    { "date": "2023-10-02", "value": 12 }
  ],
  "ratingData": [
    { "code": "COOK100", "getyear": "2018", "getmonth": "10", "getday": "21", "reason": "Cook-Off", "penality": 0, "rank": "1", "rating": "3000" }
  ]
}
                        </pre>
                    </div>
                </div>

                <!-- Schema 2: Bulk Users -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 border-b border-slate-800 pb-12">
                    <div class="lg:col-span-1">
                        <h3 class="text-xl font-bold text-white mb-2">Bulk Users</h3>
                        <code class="text-sm text-brand-400 bg-brand-900/30 px-2 py-1 rounded">/api/users</code>
                        <p class="text-slate-400 mt-4 text-sm leading-relaxed">
                            Returns a list of lightweight user objects. Does not include heavy data like heatmaps or full rating history to ensure fast response times.
                        </p>
                    </div>
                    <div class="lg:col-span-2 bg-slate-950 rounded-xl p-6 border border-slate-800 overflow-hidden relative group">
                        <div class="absolute top-0 left-0 w-full h-8 bg-slate-900 border-b border-slate-800 flex items-center px-4 gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="text-xs sm:text-sm text-slate-300 font-mono mt-6 overflow-x-auto max-h-96 custom-scrollbar">
{
  "success": true,
  "users": [
    {
      "success": true,
      "status": 200,
      "profile": "https://cdn.codechef.com/...",
      "name": "Neal Wu",
      "currentRating": 2650,
      "highestRating": 2700,
      "countryName": "United States",
      "globalRank": 12,
      "stars": "6★"
    },
    {
      "success": true,
      "status": 200,
      "profile": "https://cdn.codechef.com/...",
      "name": "Gennady",
      "currentRating": 3979,
      "stars": "7★"
    }
  ]
}
                        </pre>
                    </div>
                </div>

                <!-- Schema 3: Rating History -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 border-b border-slate-800 pb-12">
                    <div class="lg:col-span-1">
                        <h3 class="text-xl font-bold text-white mb-2">Rating History</h3>
                        <code class="text-sm text-brand-400 bg-brand-900/30 px-2 py-1 rounded">/api/rating/{username}</code>
                        <p class="text-slate-400 mt-4 text-sm leading-relaxed">
                            Returns only the array of rating changes for a user. Useful for building custom charts or analyzing contest performance over time.
                        </p>
                    </div>
                    <div class="lg:col-span-2 bg-slate-950 rounded-xl p-6 border border-slate-800 overflow-hidden relative group">
                        <div class="absolute top-0 left-0 w-full h-8 bg-slate-900 border-b border-slate-800 flex items-center px-4 gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="text-xs sm:text-sm text-slate-300 font-mono mt-6 overflow-x-auto max-h-96 custom-scrollbar">
{
  "success": true,
  "ratingData": [
    {
      "code": "START100",
      "getyear": "2023",
      "getmonth": "08",
      "getday": "30",
      "reason": "Starters 100",
      "penality": 0,
      "rank": "5",
      "rating": "2650"
    },
    {
      "code": "COOK140",
      "getyear": "2023",
      "getmonth": "07",
      "getday": "15",
      "reason": "Cook-Off",
      "penality": 0,
      "rank": "12",
      "rating": "2610"
    }
  ]
}
                        </pre>
                    </div>
                </div>

                 <!-- Schema 4: Heatmap Data -->
                 <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-1">
                        <h3 class="text-xl font-bold text-white mb-2">Heatmap Data</h3>
                        <code class="text-sm text-brand-400 bg-brand-900/30 px-2 py-1 rounded">/api/heatmap-data/{username}</code>
                        <p class="text-slate-400 mt-4 text-sm leading-relaxed">
                            Returns raw heatmap data points. Each object represents a day with submissions.
                        </p>
                    </div>
                    <div class="lg:col-span-2 bg-slate-950 rounded-xl p-6 border border-slate-800 overflow-hidden relative group">
                        <div class="absolute top-0 left-0 w-full h-8 bg-slate-900 border-b border-slate-800 flex items-center px-4 gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <pre class="text-xs sm:text-sm text-slate-300 font-mono mt-6 overflow-x-auto max-h-96 custom-scrollbar">
{
  "success": true,
  "heatMap": [
    {
      "date": "2023-10-01",
      "value": 5
    },
    {
      "date": "2023-10-02",
      "value": 12
    },
    {
      "date": "2023-10-03",
      "value": 0
    }
  ]
}
                        </pre>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Widgets Section -->
    <div id="widgets" class="py-20 bg-slate-800/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold mb-12 border-l-4 border-purple-500 pl-4">Embeddable Widgets</h2>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <!-- Heatmap Widget -->
                <div>
                    <h3 class="text-xl font-bold mb-4">Submission Heatmap</h3>
                    <div class="glass p-2 rounded-xl mb-4">
                        <img src="/image/heatmap2.png" alt="Heatmap Preview" class="rounded-lg w-full opacity-80">
                    </div>
                    <div class="bg-slate-950 rounded-xl p-4 border border-slate-800 relative group">
                        <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text='<iframe src="https://sm-codechef.vercel.app/heatmap/{handle}?theme=night" width="100%" height="200"></iframe>'>Copy Code</button>
                        <code class="text-sm text-slate-400 break-all">
                            &lt;iframe src="https://sm-codechef.vercel.app/heatmap/{handle}?theme=night" width="100%" height="200"&gt;&lt;/iframe&gt;
                        </code>
                    </div>
                </div>

                <!-- Rating Widget -->
                <div>
                    <h3 class="text-xl font-bold mb-4">Rating Graph</h3>
                    <div class="glass p-2 rounded-xl mb-4">
                        <img src="/image/rating.png" alt="Rating Preview" class="rounded-lg w-full opacity-80">
                    </div>
                    <div class="bg-slate-950 rounded-xl p-4 border border-slate-800 relative group">
                        <button class="copy-btn absolute top-4 right-4 bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity" data-clipboard-text='<iframe src="https://sm-codechef.vercel.app/rating/{handle}" width="100%" height="400"></iframe>'>Copy Code</button>
                        <code class="text-sm text-slate-400 break-all">
                            &lt;iframe src="https://sm-codechef.vercel.app/rating/{handle}" width="100%" height="400"&gt;&lt;/iframe&gt;
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-12 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-slate-500">
                Made with ❤️ by <a href="https://github.com/shivam-smraj" class="text-brand-400 hover:underline">shivam-smraj</a>
            </p>
            <p class="text-slate-600 text-sm mt-2">Not affiliated with CodeChef.</p>
        </div>
    </footer>

    <script>
        new ClipboardJS('.copy-btn').on('success', function(e) {
            const originalText = e.trigger.innerText;
            e.trigger.innerText = 'Copied!';
            e.trigger.classList.add('bg-green-600', 'text-white');
            setTimeout(() => {
                e.trigger.innerText = originalText;
                e.trigger.classList.remove('bg-green-600', 'text-white');
            }, 2000);
            e.clearSelection();
        });
    </script>
</body>
</html>
